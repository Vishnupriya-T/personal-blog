---
const today = new Date();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-left">
      <p class="footer-copy">© {today.getFullYear()} Vishnu Priya Thanda</p>
      <p class="footer-sub">DevOps · Cloud · Automation · Dallas, TX</p>
    </div>
    <nav class="footer-links" aria-label="Footer navigation">
      <a href="/blog">Blog</a>
      <a href="/about">About</a>
      <a href="https://github.com/Vishnupriya-T" target="_blank" rel="noopener">GitHub ↗</a>
      <a href="https://www.linkedin.com/in/vishnu-priya-t/" target="_blank" rel="noopener">LinkedIn ↗</a>
      <a href="https://vishnu-monitor.vercel.app" target="_blank" rel="noopener" class="monitor-footer">● Monitor ↗</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--bg-subtle);
    margin-top: auto;
  }

  .footer-inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-copy {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 0;
    font-weight: 500;
  }

  .footer-sub {
    font-size: 0.72rem;
    color: var(--text-dim);
    margin: 0.1rem 0 0;
    font-family: 'Geist Mono', monospace;
  }

  .footer-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.15rem;
  }

  .footer-links a {
    font-size: 0.8rem;
    color: var(--text-dim);
    text-decoration: none;
    padding: 0.3rem 0.6rem;
    border-radius: var(--r-xs);
    transition: var(--transition);
    font-weight: 450;
  }

  .footer-links a:hover {
    color: var(--text-muted);
    background: var(--accent-soft);
  }

  .footer-links .monitor-footer {
    color: var(--success);
  }

  @media (max-width: 560px) {
    .footer-inner { flex-direction: column; align-items: flex-start; }
  }
</style>
