---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Ask Vishnu"
      description="Ask Vishnu's portfolio assistant about her background, skills, projects, and technical experience."
    />
    <style>
      main {
        max-width: 840px;
        min-height: calc(100vh - 180px);
        display: grid;
        align-items: center;
        padding: 4rem 1.5rem;
      }

      .gemini-panel {
        display: grid;
        gap: 1.15rem;
        padding: 1.4rem;
        background: var(--bg-subtle);
        border: 1px solid var(--border);
        border-radius: var(--r-lg);
      }

      .kicker {
        margin: 0;
        color: var(--text-subtle);
        font-family: 'Geist Mono', monospace;
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0;
        max-width: 12ch;
        font-size: clamp(2.4rem, 7vw, 4.5rem);
        line-height: 0.95;
        letter-spacing: -0.06em;
      }

      p {
        max-width: 620px;
        margin: 0;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem;
        margin-top: 0.35rem;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <section class="gemini-panel" aria-label="Ask Vishnu assistant">
        <p class="kicker">Portfolio assistant</p>
        <h1>Ask Vishnu on the homepage.</h1>
        <p>
          The primary assistant now lives in the homepage hero so visitors can ask
          about role fit, skills, projects, education, and experience without opening
          a separate test page.
        </p>
        <div class="actions">
          <a class="btn btn-primary" href="/#chat-widget">Open assistant</a>
          <a class="btn btn-outline" href="/about">View profile</a>
          <a class="btn btn-ghost" href="/blog">Read blog</a>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
