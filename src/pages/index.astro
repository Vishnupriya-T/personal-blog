---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />

    <main class="home">

      <!-- ═══ HERO / TOP SECTION ═══ -->
      <section class="hero-grid" aria-label="Introduction and AI Chat">
        <div class="hero-main">
          <div class="hero-top">
            <div class="hero-eyebrow">
              <span class="dot-live"></span>
              <span>Open to opportunities</span>
            </div>

            <h1 class="hero-title">
              Cloud & DevOps<br/>Engineer.
            </h1>

            <p class="hero-sub">
              Building reliable infrastructure, deployment automation, cloud systems,
              and practical AI/data workflows for teams that need software to run well.
            </p>

            <div class="hero-cta">
              <a href="/about" class="btn btn-primary" id="btn-about">About me</a>
              <a href="/blog" class="btn btn-outline" id="btn-blog">Read blog</a>
              <a href="https://www.linkedin.com/in/vishnu-priya-t/" target="_blank" rel="noopener" class="btn btn-ghost" id="btn-linkedin">
                LinkedIn ↗
              </a>
            </div>
          </div>

          <!-- Stats row -->
          <div class="stats-row">
            <div class="stat">
              <span class="stat-n">5+</span>
              <span class="stat-l">Years</span>
            </div>
            <div class="stat-sep"></div>
            <div class="stat">
              <span class="stat-n">1000+</span>
              <span class="stat-l">Services</span>
            </div>
            <div class="stat-sep"></div>
            <div class="stat">
              <span class="stat-n">CKA</span>
              <span class="stat-l">Certified</span>
            </div>
            <div class="stat-sep"></div>
            <div class="stat">
              <span class="stat-n">MS</span>
              <span class="stat-l">Data Science Graduate</span>
            </div>
          </div>
        </div>

        <!-- RIGHT: Chat panel -->
        <aside class="chat-col" aria-label="AI chat assistant">
          <div class="chat-card card" id="chat-widget">

            <div class="chat-hd">
              <div class="chat-hd-left">
                <div class="chat-avatar">VP</div>
                <div>
                  <p class="chat-name">Ask Vishnu <span class="badge badge-white">AI</span></p>
                  <p class="chat-status"><span class="dot-live small"></span> Online</p>
                </div>
              </div>
              <button class="btn btn-ghost icon-sm" id="chat-clear-btn" title="Clear conversation" aria-label="Clear chat">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg>
              </button>
            </div>

            <div class="chat-msgs" id="chat-msgs" aria-live="polite" aria-label="Chat messages">
              <div class="msg msg-ai">
                <p>Hi! I'm Vishnu's AI assistant. Ask me about my background, projects, or skills — I'll answer based on what I know about Vishnu.</p>
              </div>
            </div>

            <!-- Quick prompts -->
            <div class="quick-prompts" id="quick-prompts">
              <button class="qp-btn" data-q="What kinds of roles fit your background?">Role fit</button>
              <button class="qp-btn" data-q="What are your strongest technical skills?">Core skills</button>
              <button class="qp-btn" data-q="What AI or data projects have you built?">AI/data projects</button>
              <button class="qp-btn" data-q="What certifications and education do you have?">Education</button>
            </div>

            <div class="chat-input-area">
              <textarea
                id="chat-input"
                rows="1"
                placeholder="Ask about experience, projects, skills…"
                aria-label="Type your question"
              ></textarea>
              <button class="send-btn btn-primary btn" id="chat-send" aria-label="Send">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <line x1="22" y1="2" x2="11" y2="13"/>
                  <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                </svg>
              </button>
            </div>

            <p class="chat-footer-note">Powered by Gemini · Multi-turn conversation</p>
          </div>
        </aside>
      </section>

      <div class="divider"></div>

      <!-- ═══ EXPERTISE ═══ -->
      <section class="expertise-sec" aria-label="Professional Expertise">
        <div class="skills-col">
          <p class="col-label">Expertise</p>

          <ul class="skills-grid" role="list">
            <li class="skill-item" id="skill-platform">
              <div class="skill-num">01</div>
              <div class="skill-body">
                <h3>Infrastructure & Cloud</h3>
                <p>AWS, Azure, Linux, networking, Terraform, and Kubernetes foundations for reliable systems.</p>
                <div class="skill-tags">
                  <span class="badge">kubernetes</span>
                  <span class="badge">terraform</span>
                  <span class="badge">helm</span>
                  <span class="badge">eks</span>
                </div>
              </div>
            </li>

            <li class="skill-item" id="skill-cicd">
              <div class="skill-num">02</div>
              <div class="skill-body">
                <h3>CI/CD & Automation</h3>
                <p>Build, release, validation, scripting, and workflow automation across modern engineering teams.</p>
                <div class="skill-tags">
                  <span class="badge">jenkins</span>
                  <span class="badge">github-actions</span>
                  <span class="badge">fortify</span>
                </div>
              </div>
            </li>

            <li class="skill-item" id="skill-cloud">
              <div class="skill-num">03</div>
              <div class="skill-body">
                <h3>Reliability & Operations</h3>
                <p>Monitoring, incident response, runbooks, deployment checks, and operational guardrails.</p>
                <div class="skill-tags">
                  <span class="badge">aws</span>
                  <span class="badge">azure</span>
                  <span class="badge">ansible</span>
                </div>
              </div>
            </li>

            <li class="skill-item" id="skill-ai">
              <div class="skill-num">04</div>
              <div class="skill-body">
                <h3>AI & Data Systems</h3>
                <p>LangChain, embeddings, FAISS, Streamlit, SageMaker, Python, and production-minded AI workflows.</p>
                <div class="skill-tags">
                  <span class="badge">langchain</span>
                  <span class="badge">faiss</span>
                  <span class="badge">sagemaker</span>
                </div>
              </div>
            </li>
          </ul>
        </div>
      </section>

    </main>

    <Footer />

    <style>
      /* ── HOME ── */
      .home {
        max-width: 1080px;
        margin: 0 auto;
        padding: 3.5rem 1.5rem 5rem;
        display: flex;
        flex-direction: column;
        gap: 3rem;
      }

      /* ── HERO ── */
      .hero-grid {
        display: grid;
        grid-template-columns: 1fr 380px;
        gap: 3rem;
        align-items: start;
        animation: fadeIn 0.5s ease both;
      }

      .hero-main {
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
      }

      .hero-top {
        display: flex;
        flex-direction: column;
        gap: 1.15rem;
        max-width: 620px;
      }

      .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.78rem;
        font-weight: 500;
        color: var(--text-subtle);
        letter-spacing: 0.04em;
        text-transform: uppercase;
        font-family: 'Geist Mono', monospace;
      }

      .dot-live {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--success);
        box-shadow: 0 0 6px var(--success);
        display: inline-block;
        animation: blink 2s ease-in-out infinite;
        flex-shrink: 0;
      }
      .dot-live.small { width: 5px; height: 5px; }

      .hero-title {
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        font-weight: 800;
        letter-spacing: -0.05em;
        line-height: 1.0;
        color: var(--text);
        margin: 0;
      }

      .hero-sub {
        font-size: 1rem;
        color: var(--text-muted);
        line-height: 1.7;
        margin: 0;
        max-width: 520px;
      }

      .hero-cta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: center;
        margin-top: 0.25rem;
      }

      /* Stats */
      .stats-row {
        display: flex;
        align-items: center;
        gap: 0;
        background: var(--bg-subtle);
        border: 1px solid var(--border);
        border-radius: var(--r-lg);
        overflow: hidden;
        width: fit-content;
      }

      .stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.15rem;
        padding: 1rem 2rem;
      }

      .stat-n {
        font-size: 1.4rem;
        font-weight: 800;
        letter-spacing: -0.04em;
        color: var(--text);
        font-family: 'Geist', sans-serif;
        line-height: 1;
      }

      .stat-l {
        font-size: 0.68rem;
        color: var(--text-dim);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        font-weight: 500;
        font-family: 'Geist Mono', monospace;
      }

      .stat-sep {
        width: 1px;
        height: 40px;
        background: var(--border);
        flex-shrink: 0;
      }

      /* Divider */
      .divider {
        height: 1px;
        background: var(--border);
      }

      /* ── SKILLS ── */
      .col-label {
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-dim);
        margin-bottom: 1.25rem;
        font-family: 'Geist Mono', monospace;
      }

      .skills-grid {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0 2.5rem;
      }

      .skill-item {
        display: flex;
        gap: 1.25rem;
        padding: 1.5rem 0;
        border-bottom: 1px solid var(--border);
        transition: var(--transition);
        cursor: default;
      }

      @media (min-width: 769px) {
        .skill-item:nth-child(1),
        .skill-item:nth-child(2) {
          padding-top: 0;
        }
        .skill-item:nth-last-child(-n+2) {
          border-bottom: none;
          padding-bottom: 0;
        }
      }

      @media (max-width: 768px) {
        .skills-grid {
          grid-template-columns: 1fr;
          gap: 0;
        }
        .skill-item:first-child {
          padding-top: 0;
        }
        .skill-item:last-child {
          border-bottom: none;
          padding-bottom: 0;
        }
      }

      .skill-item:hover .skill-num { color: var(--text-muted); }

      .skill-num {
        font-size: 0.72rem;
        color: var(--text-dim);
        font-weight: 500;
        font-family: 'Geist Mono', monospace;
        padding-top: 0.25rem;
        flex-shrink: 0;
        width: 24px;
        transition: var(--transition);
      }

      .skill-body h3 {
        font-size: 0.95rem;
        font-weight: 600;
        margin-bottom: 0.4rem;
        color: var(--text);
      }

      .skill-body p {
        font-size: 0.83rem;
        color: var(--text-subtle);
        margin-bottom: 0.75rem;
        line-height: 1.6;
      }

      .skill-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
      }

      /* ── CHAT ── */
      .chat-col {
        position: sticky;
        top: 72px;
        animation: slideRight 0.5s 0.15s ease both;
      }

      .chat-card {
        display: flex;
        flex-direction: column;
        height: 540px;
        overflow: hidden;
      }

      /* Chat header */
      .chat-hd {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.1rem;
        border-bottom: 1px solid var(--border);
        flex-shrink: 0;
      }

      .chat-hd-left {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      .chat-avatar {
        width: 34px;
        height: 34px;
        background: var(--text);
        color: var(--bg);
        border-radius: var(--r-sm);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.65rem;
        font-weight: 800;
        font-family: 'Geist Mono', monospace;
        flex-shrink: 0;
      }

      .chat-name {
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--text);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        line-height: 1;
        padding-bottom: 0.2rem;
      }

      .chat-status {
        font-size: 0.7rem;
        color: var(--text-dim);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.35rem;
        line-height: 1;
      }

      .icon-sm {
        width: 28px;
        height: 28px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      /* Messages */
      .chat-msgs {
        flex: 1;
        overflow-y: auto;
        padding: 1rem 1.1rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      /* Row wraps label + bubble */
      .msg-row {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        max-width: 90%;
      }
      .msg-row.msg-row-user {
        align-self: flex-end;
        align-items: flex-end;
      }
      .msg-row.msg-row-ai {
        align-self: flex-start;
        align-items: flex-start;
      }

      .msg-label {
        font-size: 0.66rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text-dim);
        font-family: 'Geist Mono', monospace;
        padding: 0 0.2rem;
      }

      /* Bubble */
      .bubble {
        font-size: 0.84rem;
        line-height: 1.65;
        padding: 0.65rem 0.95rem;
        border-radius: var(--r-md);
        word-break: break-word;
      }

      /* AI bubble */
      .bubble-ai {
        background: var(--bg-muted);
        border: 1px solid var(--border);
        color: var(--text-muted);
        border-bottom-left-radius: var(--r-xs);
      }
      /* AI bubble markdown styles */
      .bubble-ai strong { color: var(--text); font-weight: 600; }
      .bubble-ai em { font-style: italic; }
      .bubble-ai code {
        font-family: 'Geist Mono', monospace;
        font-size: 0.78rem;
        background: var(--bg-elevated);
        border: 1px solid var(--border-soft);
        padding: 0.1em 0.4em;
        border-radius: 3px;
        color: var(--text);
      }
      .bubble-ai ul, .bubble-ai ol {
        margin: 0.5rem 0 0.25rem 1.1rem;
        padding: 0;
        color: var(--text-muted);
      }
      .bubble-ai li { margin-bottom: 0.3rem; }
      .bubble-ai p { margin: 0 0 0.5rem; color: var(--text-muted); }
      .bubble-ai p:last-child { margin-bottom: 0; }

      /* User bubble */
      .bubble-user {
        background: var(--text);
        color: var(--bg);
        border-bottom-right-radius: var(--r-xs);
        font-weight: 450;
      }

      /* Error bubble */
      .bubble-error {
        background: transparent;
        border: 1px dashed var(--border-soft);
        color: var(--text-dim);
        border-radius: var(--r-md);
        font-size: 0.8rem;
        font-style: italic;
      }

      /* Typing indicator */
      .bubble.typing {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 0.7rem 0.9rem;
      }
      .typing-dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--text-dim);
        animation: typing-bounce 1.2s ease-in-out infinite;
      }
      .typing-dot:nth-child(2) { animation-delay: 0.15s; }
      .typing-dot:nth-child(3) { animation-delay: 0.3s; }

      @keyframes typing-bounce {
        0%, 80%, 100% { transform: scale(1); opacity: 0.5; }
        40%            { transform: scale(1.3); opacity: 1; }
      }

      /* Quick prompts */
      .quick-prompts {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
        padding: 0.6rem 1.1rem;
        border-top: 1px solid var(--border);
        flex-shrink: 0;
      }

      .qp-btn {
        font-size: 0.72rem;
        padding: 0.3rem 0.65rem;
        background: var(--bg-muted);
        border: 1px solid var(--border);
        border-radius: var(--r-xs);
        color: var(--text-muted);
        cursor: pointer;
        transition: var(--transition);
        font-family: 'Geist', sans-serif;
        font-weight: 500;
        white-space: nowrap;
      }
      .qp-btn:hover {
        border-color: var(--border-soft);
        color: var(--text);
        background: var(--bg-elevated);
      }

      /* Input */
      .chat-input-area {
        display: flex;
        align-items: flex-end;
        gap: 0.5rem;
        padding: 0.75rem 1.1rem;
        border-top: 1px solid var(--border);
        flex-shrink: 0;
      }

      #chat-input {
        flex: 1;
        padding: 0.55rem 0.75rem;
        border-radius: var(--r-sm);
        font-size: 0.83rem;
        min-height: 36px;
        max-height: 110px;
        line-height: 1.5;
        resize: none;
        overflow-y: auto;
      }

      .send-btn {
        width: 34px;
        height: 34px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: var(--r-sm);
      }
      .send-btn:hover { transform: translateY(-1px); }
      .send-btn:disabled { opacity: 0.4; cursor: not-allowed; transform: none; }

      .chat-footer-note {
        text-align: center;
        font-size: 0.65rem;
        color: var(--text-dim);
        padding: 0.4rem 1rem;
        margin: 0;
        font-family: 'Geist Mono', monospace;
        flex-shrink: 0;
        border-top: 1px solid var(--border);
      }

      /* ── RESPONSIVE ── */
      @media (max-width: 880px) {
        .hero-grid { grid-template-columns: 1fr; gap: 2.5rem; }
        .chat-col { position: static; }
        .chat-card { height: 460px; }
      }

      @media (max-width: 600px) {
        .home { padding: 2rem 1rem 4rem; gap: 2.5rem; }
        .hero-title { font-size: 2.5rem; }
        .stats-row { width: 100%; justify-content: space-between; }
        .stat { padding: 0.85rem 1rem; }
        .stat-sep { height: 30px; }
      }
    </style>

    <script type="module">
      const sendBtn      = document.getElementById('chat-send');
      const clearBtn     = document.getElementById('chat-clear-btn');
      const input        = document.getElementById('chat-input');
      const msgsEl       = document.getElementById('chat-msgs');
      const quickPrompts = document.getElementById('quick-prompts');

      let history   = [];
      let isLoading = false;

      /* Auto-grow */
      input.addEventListener('input', () => {
        input.style.height = 'auto';
        input.style.height = Math.min(input.scrollHeight, 110) + 'px';
      });

      /* Enter to send */
      input.addEventListener('keydown', e => {
        if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(); }
      });

      sendBtn.addEventListener('click', send);
      clearBtn.addEventListener('click', () => {
        history = [];
        msgsEl.innerHTML = `<div class="msg msg-ai"><p>Conversation cleared. Ask me anything about Vishnu's background!</p></div>`;
        quickPrompts.style.display = 'flex';
      });

      document.querySelectorAll('.qp-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          input.value = btn.dataset.q;
          quickPrompts.style.display = 'none';
          send();
        });
      });

      /* ── Lightweight markdown → HTML ── */
      function renderMarkdown(text) {
        // Escape HTML first
        let s = text
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;');

        // Fenced code blocks
        s = s.replace(/```[\w]*\n([\s\S]*?)```/g, '<pre><code>$1</code></pre>');

        // Bold + italic combos first
        s = s.replace(/\*\*\*(.+?)\*\*\*/g, '<strong><em>$1</em></strong>');
        // Bold
        s = s.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
        // Italic
        s = s.replace(/\*(.+?)\*/g, '<em>$1</em>');
        // Inline code
        s = s.replace(/`([^`]+)`/g, '<code>$1</code>');

        // Lists — collect consecutive bullet lines into <ul>
        s = s.replace(/((?:[ \t]*[*\-][ \t]+.+\n?)+)/g, (block) => {
          const items = block.trim().split('\n').map(line =>
            '<li>' + line.replace(/^[ \t]*[*\-][ \t]+/, '') + '</li>'
          ).join('');
          return '<ul>' + items + '</ul>';
        });

        // Numbered lists
        s = s.replace(/((?:[ \t]*\d+\.[ \t]+.+\n?)+)/g, (block) => {
          const items = block.trim().split('\n').map(line =>
            '<li>' + line.replace(/^[ \t]*\d+\.[ \t]+/, '') + '</li>'
          ).join('');
          return '<ol>' + items + '</ol>';
        });

        // Paragraphs — double newline → paragraph breaks
        s = s.split(/\n{2,}/).map(para => {
          para = para.trim();
          if (!para) return '';
          if (para.startsWith('<ul>') || para.startsWith('<ol>') || para.startsWith('<pre>')) return para;
          return '<p>' + para.replace(/\n/g, '<br>') + '</p>';
        }).join('');

        return s;
      }

      function addMsg(role, text) {
        const isUser = role === 'user';
        const row = document.createElement('div');
        row.className = `msg-row msg-row-${isUser ? 'user' : 'ai'}`;

        const label = document.createElement('span');
        label.className = 'msg-label';
        label.textContent = isUser ? 'You' : 'Vishnu AI';

        const bubble = document.createElement('div');
        bubble.className = `bubble bubble-${isUser ? 'user' : 'ai'}`;
        if (isUser) {
          bubble.textContent = text;
        } else {
          bubble.innerHTML = renderMarkdown(text);
        }

        row.appendChild(label);
        row.appendChild(bubble);
        msgsEl.appendChild(row);
        msgsEl.scrollTop = msgsEl.scrollHeight;
        return bubble;
      }

      function addErrorMsg(message) {
        const row = document.createElement('div');
        row.className = 'msg-row msg-row-ai';
        const label = document.createElement('span');
        label.className = 'msg-label';
        label.textContent = 'Error';
        const bubble = document.createElement('div');
        bubble.className = 'bubble bubble-error';
        bubble.textContent = message;
        row.appendChild(label);
        row.appendChild(bubble);
        msgsEl.appendChild(row);
        msgsEl.scrollTop = msgsEl.scrollHeight;
      }

      function showTyping() {
        const row = document.createElement('div');
        row.className = 'msg-row msg-row-ai';
        row.id = 'typing-row';
        const label = document.createElement('span');
        label.className = 'msg-label';
        label.textContent = 'Vishnu AI';
        const bubble = document.createElement('div');
        bubble.className = 'bubble bubble-ai typing';
        bubble.innerHTML = '<span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span>';
        row.appendChild(label);
        row.appendChild(bubble);
        msgsEl.appendChild(row);
        msgsEl.scrollTop = msgsEl.scrollHeight;
      }
      function hideTyping() { document.getElementById('typing-row')?.remove(); }

      async function send() {
        if (isLoading) return;
        const question = input.value.trim();
        if (!question) return;

        isLoading = true;
        sendBtn.disabled = true;
        input.value = '';
        input.style.height = 'auto';
        quickPrompts.style.display = 'none';

        addMsg('user', question);
        history.push({ role: 'user', text: question });
        showTyping();

        try {
          const res = await fetch('/api/gemini', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ question, history: history.slice(0,-1), stream: true }),
          });

          hideTyping();

          if (!res.ok) {
            const err = await res.json().catch(() => ({}));
            // Remove the last user message from history since it failed
            history.pop();
            addErrorMsg(err.error || 'Request failed. Please try again.');
            return;
          }

          const bubble = addMsg('ai', '');
          let full = '';
          let streamError = null;

          const reader = res.body.getReader();
          const dec    = new TextDecoder();
          let buf = '';

          while (true) {
            const { done, value } = await reader.read();
            if (done) break;
            buf += dec.decode(value, { stream: true });
            const parts = buf.split('\n\n');
            buf = parts.pop();
            for (const part of parts) {
              for (const line of part.split('\n')) {
                if (line.startsWith('data: ')) {
                  try {
                    const p = JSON.parse(line.slice(6));
                    if (p.type === 'chunk') {
                      full += p.text || '';
                      bubble.innerHTML = renderMarkdown(full);
                      msgsEl.scrollTop = msgsEl.scrollHeight;
                    } else if (p.type === 'error') {
                      streamError = p.error;
                    }
                  } catch {}
                }
              }
            }
          }

          // Stream returned an error event
          if (streamError && !full) {
            bubble.closest('.msg-row')?.remove();
            history.pop();
            addErrorMsg(streamError);
            return;
          }

          // Stream returned nothing — try non-streaming fallback
          if (!full) {
            try {
              const fb = await fetch('/api/gemini', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ question, history: history.slice(0,-1), stream: false }),
              });
              const data = await fb.json().catch(() => ({}));
              if (!fb.ok || data.error) {
                bubble.closest('.msg-row')?.remove();
                history.pop();
                addErrorMsg(data.error || 'No response received.');
                return;
              }
              full = data.text || 'No response.';
              bubble.innerHTML = renderMarkdown(full);
            } catch {
              bubble.closest('.msg-row')?.remove();
              history.pop();
              addErrorMsg('Connection error. Please try again.');
              return;
            }
          }

          history.push({ role: 'assistant', text: full });
        } catch (e) {
          hideTyping();
          history.pop();
          addErrorMsg('Connection error. Please check your network and try again.');
        } finally {
          isLoading = false;
          sendBtn.disabled = false;
        }
      }
    </script>
  </body>
</html>
