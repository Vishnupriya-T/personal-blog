---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hi, I’m Vishnu.</h1>
			<p>
				Senior DevOps Engineer with 5+ years of experience building and operating scalable Kubernetes platforms, cloud infrastructure, and automation for enterprise microservices environments.
			</p>
			<p>
				I specialize in platform engineering, CI/CD governance, containerized deployments, and AI/MLOps-ready infrastructure for resilient, secure distributed systems.
			</p>
			<ul>
				<li>Platform engineering: Kubernetes, EKS, Terraform, Jenkins, Helm, and infrastructure automation.</li>
				<li>Governance & compliance: secure CI/CD, deployment guardrails, platform observability, and failover automation.</li>
				<li>AI/MLOps: LangChain, OpenAI embeddings, Streamlit, FAISS, and containerized model deployment.</li>
			</ul>
			<p>
				Explore my <a href="/about">About</a> page or read my technical posts in <a href="/blog">Blog</a>. Connect with me on
				<a href="https://www.linkedin.com/in/vishnu-priya-t/" target="_blank">LinkedIn</a> or
				<a href="https://github.com/Vishnupriya-T" target="_blank">GitHub</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>
