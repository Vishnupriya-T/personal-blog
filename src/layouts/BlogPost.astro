---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style>
      .article-wrap {
        width: 100%;
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem 1.5rem 4rem;
      }

      .hero-image {
        width: 100%;
        border-radius: var(--r-xl);
        overflow: hidden;
        margin-bottom: 2.5rem;
        box-shadow: var(--shadow-lg);
        border: 1px solid var(--border);
      }

      .hero-image img {
        display: block;
        width: 100%;
        height: 380px;
        object-fit: cover;
        border-radius: var(--r-xl);
        margin: 0;
      }

      .prose {
        width: 720px;
        max-width: 100%;
        margin: 0 auto;
      }

      .title-block {
        text-align: center;
        margin-bottom: 2.5rem;
        padding-bottom: 2rem;
        border-bottom: 1px solid var(--border);
      }

      .date-row {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1rem;
        font-size: 0.82rem;
        color: var(--text-muted);
        font-weight: 500;
      }

      .date-row .dot { opacity: 0.4; }

      .last-updated {
        font-style: italic;
        color: var(--text-muted);
        font-size: 0.8rem;
      }

      .prose h1 {
        font-size: clamp(1.8rem, 4vw, 2.8rem);
        font-weight: 800;
        letter-spacing: -0.03em;
        color: var(--text);
        margin: 0;
        line-height: 1.15;
      }

      /* Prose content */
      .prose-content {
        color: var(--text-muted);
        line-height: 1.8;
      }

      .prose-content h2 {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--text);
        margin: 2.5rem 0 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--border);
      }

      .prose-content h3 {
        font-size: 1.2rem;
        font-weight: 600;
        color: var(--text);
        margin: 2rem 0 0.75rem;
      }

      .prose-content p { margin-bottom: 1.4em; }

      .prose-content a {
        color: var(--text);
        border-bottom: 1px solid var(--border-soft);
        transition: var(--transition);
      }
      .prose-content a:hover {
        color: var(--text-muted);
        border-color: var(--text-muted);
      }

      .prose-content ul, .prose-content ol {
        padding-left: 1.75rem;
        margin-bottom: 1.5rem;
      }
      .prose-content li { margin-bottom: 0.5rem; }

      .prose-content strong { color: var(--text); }

      @media (max-width: 768px) {
        .article-wrap { padding: 1.5rem 1rem 3rem; }
        .hero-image img { height: 220px; }
      }
    </style>
  </head>

  <body>
    <Header />
    <main class="article-wrap">
      <article>
        {heroImage && (
          <div class="hero-image">
            <Image width={1020} height={510} src={heroImage} alt={title} />
          </div>
        )}
        <div class="prose">
          <div class="title-block">
            <div class="date-row">
              <FormattedDate date={pubDate} />
              {updatedDate && (
                <>
                  <span class="dot">·</span>
                  <span class="last-updated">Updated <FormattedDate date={updatedDate} /></span>
                </>
              )}
            </div>
            <h1>{title}</h1>
          </div>
          <div class="prose-content">
            <slot />
          </div>
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
